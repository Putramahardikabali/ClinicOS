REACT_APP_BACKEND_URL=https://api.clinicos.id

# Frontend build uses Create React App (craco). Production Docker maps VITE_* args → REACT_APP_*.
VITE_API_BASE_URL=https://api.clinicos.id
REACT_APP_PUBLIC_UPLOAD_BASE_URL=https://api.clinicos.id/uploads
REACT_APP_MANIFEST_URL=https://api.clinicos.id/manifest.webmanifest

REACT_APP_APP_ENV=production
REACT_APP_BETA_MODE=false

# Demo Clinic login (/demo). Baked into the frontend image at build time.
# WARNING: Demo password is embedded in the frontend bundle and should only be used for public demo
# accounts with fake data. Without VITE_DEMO_PASSWORD, /demo role cards show "Coming soon".
VITE_DEMO_PASSWORD=12345678
VITE_DEMO_OWNER_EMAIL=owner@democlinic.com
VITE_DEMO_MANAGER_EMAIL=manager@democlinic.com
VITE_DEMO_FO_EMAIL=fo@democlinic.com
VITE_DEMO_DOCTOR_EMAIL=doctor1@democlinic.com
VITE_DEMO_THERAPIST_EMAIL=therapist1@democlinic.com
VITE_DEMO_ACCOUNTING_EMAIL=acc@democlinic.com
