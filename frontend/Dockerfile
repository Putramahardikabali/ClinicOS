FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=https://api.clinicos.id
ARG REACT_APP_PUBLIC_UPLOAD_BASE_URL=
ARG REACT_APP_APP_ENV=production
ARG REACT_APP_BETA_MODE=
ARG VITE_DEMO_PASSWORD=
ARG VITE_DEMO_OWNER_EMAIL=
ARG VITE_DEMO_MANAGER_EMAIL=
ARG VITE_DEMO_FO_EMAIL=
ARG VITE_DEMO_DOCTOR_EMAIL=
ARG VITE_DEMO_THERAPIST_EMAIL=
ARG VITE_DEMO_ACCOUNTING_EMAIL=

ENV REACT_APP_BACKEND_URL=${VITE_API_BASE_URL}
ENV REACT_APP_PUBLIC_UPLOAD_BASE_URL=${REACT_APP_PUBLIC_UPLOAD_BASE_URL}
ENV REACT_APP_APP_ENV=${REACT_APP_APP_ENV}
ENV REACT_APP_BETA_MODE=${REACT_APP_BETA_MODE}
ENV REACT_APP_DEMO_PASSWORD=${VITE_DEMO_PASSWORD}
ENV REACT_APP_DEMO_OWNER_EMAIL=${VITE_DEMO_OWNER_EMAIL}
ENV REACT_APP_DEMO_MANAGER_EMAIL=${VITE_DEMO_MANAGER_EMAIL}
ENV REACT_APP_DEMO_FO_EMAIL=${VITE_DEMO_FO_EMAIL}
ENV REACT_APP_DEMO_DOCTOR_EMAIL=${VITE_DEMO_DOCTOR_EMAIL}
ENV REACT_APP_DEMO_THERAPIST_EMAIL=${VITE_DEMO_THERAPIST_EMAIL}
ENV REACT_APP_DEMO_ACCOUNTING_EMAIL=${VITE_DEMO_ACCOUNTING_EMAIL}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
