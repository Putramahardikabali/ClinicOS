# Copy to .env on the Dokploy host (do not commit real secrets).
# Used by docker-compose.prod.yml (backend env_file + frontend build args).

# --- Backend ---
APP_ENV=production
BETA_MODE=true

FRONTEND_URL=https://app.clinicos.id
BACKEND_URL=https://api.clinicos.id
CORS_ORIGINS=https://app.clinicos.id

MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/clinicos_prod?retryWrites=true&w=majority
DB_NAME=clinicos_prod
JWT_SECRET=change_me_to_long_random_secret

APP_NAME=clinicos
ENABLE_API_DOCS=false

SUPER_ADMIN_EMAIL=platform@clinicos.id
SUPER_ADMIN_PASSWORD=change_me_strong_password

USE_LOCAL_UPLOADS=true
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_BASE_URL=https://api.clinicos.id/uploads
MAX_UPLOAD_BYTES=10485760

MESSAGING_ENABLED=false
PAYMENT_MODE=disabled

# --- Frontend build (docker compose build args) ---
VITE_API_BASE_URL=https://api.clinicos.id
REACT_APP_PUBLIC_UPLOAD_BASE_URL=https://api.clinicos.id/uploads
REACT_APP_APP_ENV=production
REACT_APP_BETA_MODE=true

# Demo Clinic (/demo). Embedded in the frontend bundle — fake demo accounts only.
VITE_DEMO_PASSWORD=12345678
VITE_DEMO_OWNER_EMAIL=owner@democlinic.com
VITE_DEMO_MANAGER_EMAIL=manager@democlinic.com
VITE_DEMO_FO_EMAIL=fo@democlinic.com
VITE_DEMO_DOCTOR_EMAIL=doctor1@democlinic.com
VITE_DEMO_THERAPIST_EMAIL=therapist1@democlinic.com
VITE_DEMO_ACCOUNTING_EMAIL=acc@democlinic.com
