APP_ENV=production
BETA_MODE=false

MONGO_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=clinicos_prod

JWT_SECRET=<generate-a-strong-random-secret>

APP_NAME=clinicos
FRONTEND_URL=https://app.clinicos.id
BACKEND_URL=https://api.clinicos.id
CORS_ORIGINS=https://app.clinicos.id
ENABLE_API_DOCS=false

STORAGE_URL=<your-object-storage-api-url>
EMERGENT_LLM_KEY=<optional-if-using-emergent-storage>
USE_LOCAL_UPLOADS=true
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_BASE_URL=https://api.clinicos.id/uploads
MAX_UPLOAD_BYTES=10485760

SUPER_ADMIN_EMAIL=platform@clinicos.id
SUPER_ADMIN_PASSWORD=<set-strong-password-or-use-seed-script>

SUPPORT_WHATSAPP=<optional-support-number>
SUPPORT_HOURS=Mon-Fri 9am-6pm
